package routines;

public class CapitalizeEachWord {
	
	/**
	 * Capitalize: capitalize first letter of each word only
	 *
	 *
	 * {talendTypes} String
	 *
	 * {Category} User defined
	 *
	 * {@param} string type: this function requires an input parameter
	 *
	 * {example} capitailizeOnlyFirst("mr. hamza saber") # returns "Mr. Hamza Saber"
	 */
	public static String capitailizeOnlyFirst(String str) { 
        StringBuffer s = new StringBuffer(); 
  
        // Declare a character of space 
        // To identify that the next character is the starting 
        // of a new word 
        char ch = ' '; 
        for (int i = 0; i < str.length(); i++) { 
              
            // If previous character is space and current 
            // character is not space then it shows that 
            // current letter is the starting of the word 
            if (ch == ' ' && str.charAt(i) != ' ') 
                s.append(Character.toUpperCase(str.charAt(i))); 
            else
                s.append(Character.toLowerCase(str.charAt(i))); 
            ch = str.charAt(i); 
        } 
  
        // Return the string with trimming 
        return s.toString().trim(); 
    } 
	
	
}
